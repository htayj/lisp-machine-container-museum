+#include "cadr_m8_m9_input_witness.h"
+#endif
 
 #include "iob.h"
 #include "kbd.h"
@@ -61,6 +65,10 @@ cadet_allup_event(int mods)
 	int v;
 
 	v = (1 << 15) | (mods & 01777);
+#ifdef WITH_CADR_M8_M9_INPUT_WITNESS
+	if (cadr_m8_m9_input_witness_keyboard(machine_cycles, iob_csr, v, 2) != 0)
+		errx(1, "C-M8/M9 pre-IOB keyboard all-up witness failed");
+#endif
	if (iob_csr & (1 << 5))
		kbd_queue_key_event(v);	/* Already something there, queue this. */
	else {
@@ -73,11 +81,33 @@ cadet_allup_event(int mods)
 	}
 }
 
+#ifdef WITH_CADR_M8_M9_INPUT_WITNESS
+static void
+cadr_m8_m9_witnessed_queue_key_event(int ev)
+{
+	int code;
+	int keydown;
+
+	if (ev & (1 << 15)) {
+		code = ev;
+		keydown = 2;
+	} else {
+		code = ev & 0377;
+		keydown = (ev & (1 << 8)) ? 0 : 1;
+	}
+	if (cadr_m8_m9_input_witness_keyboard(machine_cycles, iob_csr, code, keydown) != 0)
+		errx(1, "C-M8/M9 pre-IOB queued keyboard witness failed");
+	kbd_queue_key_event(ev);
+}
+#else
+#define cadr_m8_m9_witnessed_queue_key_event(ev) kbd_queue_key_event(ev)
+#endif
+
 static void
 cadet_queue_all_keys_up(void)
 {
 	cadet_shifts = CADET_IX_UNSHIFT;	/* Hmm... */
-	kbd_queue_key_event((1 << 15) | 0);
+	cadr_m8_m9_witnessed_queue_key_event((1 << 15) | 0);
 }
 
