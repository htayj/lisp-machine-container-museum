@@ -208,13 +238,13 @@ cadet_process_key(int keysym,	/* keysym, acts as index into kbd_map */
 		else
 			shkey = CADET_LEFT_GREEK;
-		kbd_queue_key_event(shkey);
+		cadr_m8_m9_witnessed_queue_key_event(shkey);
 	}
 	/*
 	 *  Press/lift the key itself.
 	 */
-	kbd_queue_key_event(scc | (!keydown) << 8);
+	cadr_m8_m9_witnessed_queue_key_event(scc | (!keydown) << 8);
 	if (shkey)
-		kbd_queue_key_event(shkey | 1 << 8);	/* Lift the shift. */
+		cadr_m8_m9_witnessed_queue_key_event(shkey | 1 << 8);	/* Lift the shift. */
 	/*
 	 * Re-press the previous keys.
 	 */
@@ -221,8 +251,8 @@ cadet_process_key(int keysym,	/* keysym, acts as index into kbd_map */
 	if (oshift & (1 << CADET_IX_TOP))
-		kbd_queue_key_event(CADET_LEFT_TOP);
+		cadr_m8_m9_witnessed_queue_key_event(CADET_LEFT_TOP);
 	if (oshift & (1 << CADET_IX_SHIFT))
-		kbd_queue_key_event(CADET_LEFT_SHIFT);
+		cadr_m8_m9_witnessed_queue_key_event(CADET_LEFT_SHIFT);
 	if (oshift & (1 << CADET_IX_GREEK))
-		kbd_queue_key_event(CADET_LEFT_GREEK);
+		cadr_m8_m9_witnessed_queue_key_event(CADET_LEFT_GREEK);
 	cadet_shifts = oshift;
 }
