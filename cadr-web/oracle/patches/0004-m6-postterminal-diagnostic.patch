+    if (this.closed) return;
+    this.closed = true;
+    this.rejectAll(new Error("worker closed"));
+    await this.worker.terminate();
+  }
+}
+
+class ArtifactSet {
+  constructor(items) { this.items = items; }
+  get artifacts() { return this.items.map(item => item.artifact); }
+  async close() {
+    const results = await Promise.allSettled(this.items.map(item => item.handle.close()));
+    const errors = results.filter(result => result.status === "rejected").map(result => result.reason);
+    if (errors.length === 1) throw errors[0];
+    if (errors.length > 1) throw new AggregateError(errors, "artifact close failed");
+  }
+}
+
+async function hashArtifact(artifact) {
+  const hash = createHash("sha256");
+  for (let offset = 0n; offset < artifact.byteCount; offset += 1_048_576n) {
+    const count = artifact.byteCount - offset < 1_048_576n ?
+      artifact.byteCount - offset : 1_048_576n;
+    const bytes = await artifact.readRange(offset, count);
+    if (BigInt(bytes.byteLength) !== count) throw new Error("short artifact read");
+    hash.update(bytes);
+  }
+  return new Uint8Array(hash.digest());
+}
+
+async function loadProfile() {
+  const [releaseBytes, profileText] = await Promise.all([
+    readFile(resolve(ROOT, "cadr-web/oracle/cadr-m6-release-record.json")),
+    readFile(resolve(ROOT, "cadr-web/profiles/cadr-web-303.json"), "utf8"),
+  ]);
+  const release = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(releaseBytes));
+  const profile = JSON.parse(profileText);
+  const records = new Map(release.artifacts.map(item => [item.kind, item]));
+  const declarations = new Map(profile.artifacts.map(item => [item.id, item]));
+  const expected = REQUIRED_ARTIFACTS.map(([kind, id, localPath]) => {
+    const record = records.get(kind);
+    const declared = declarations.get(id);
+    if (!/^[1-9][0-9]*$/.test(record?.byte_count ?? "") ||
+        !/^[0-9a-f]{64}$/.test(record?.sha256 ?? "") ||
+        BigInt(declared?.bytes ?? -1) !== BigInt(record.byte_count) ||
+        declared?.sha256 !== record.sha256) {
+      throw new Error(`staged release/profile mismatch for artifact kind ${kind}`);
+    }
+    return Object.freeze({ kind, id, localPath, byteCount: BigInt(record.byte_count),
+      sha256: record.sha256 });
+  });
+  const suffix = release.native_runs?.[0]?.suffix_first_boundary;
+  if (!Array.isArray(release.native_runs) || release.native_runs.length !== 3 ||
+      !release.native_runs.every(run => run.suffix_first_boundary === suffix) ||
+      !/^[1-9][0-9]*$/.test(suffix ?? "") ||
+      !Number.isSafeInteger(release.idle_oracle?.sample_count)) {
+    throw new Error("staged release record does not supply a stable M6 bound");
+  }
+  return Object.freeze({
+    expected,
+    maxBoundaries: BigInt(suffix) + BigInt(release.idle_oracle.sample_count - 1),
+    profile: Object.freeze({ id: profile.profile.id, artifacts: expected.map(item => Object.freeze({
+      kind: item.kind, byteCount: item.byteCount, sha256: Buffer.from(item.sha256, "hex"),
+    })) }),
+    releaseBytes: new Uint8Array(releaseBytes),
+    releaseSha256: sha256(releaseBytes),
+  });
+}
+
+async function openArtifacts(expected, artifactRoot) {
+  const items = [];
+  try {
+    for (const source of expected) {
+      const path = resolve(artifactRoot, source.localPath);
+      const [metadata, handle] = await Promise.all([stat(path), open(path, "r")]);
+      if (!metadata.isFile() || BigInt(metadata.size) !== source.byteCount) {
+        await handle.close();
+        throw new Error(`input ${source.localPath} has an unexpected byte count`);
+      }
+      items.push({ handle, artifact: Object.freeze({ kind: source.kind, byteCount: source.byteCount,
+        async readRange(offset, count) {
+          if (offset < 0n || count < 0n || offset > source.byteCount ||
+              count > source.byteCount - offset || count > BigInt(Number.MAX_SAFE_INTEGER)) {
+            throw new RangeError("invalid artifact range");
+          }
+          const output = Buffer.allocUnsafe(Number(count));
+          const { bytesRead } = await handle.read(output, 0, output.byteLength, Number(offset));
+          return new Uint8Array(output.buffer, output.byteOffset, bytesRead).slice();
+        },
+      }) });
+    }
+    return new ArtifactSet(items);
+  } catch (error) {
+    await Promise.all(items.map(item => item.handle.close().catch(() => undefined)));
+    throw error;
+  }
+}
+
+function normalizeDiagnostic(value) {
+  const observed = value?.evidence?.observedAfter;
+  if (!observed || value?.trace?.active !== false ||
+      value.trace.failureLedgerUnavailable !== true || value.diskEvidence?.capacity !== 512) {
+    throw new Error("post-terminal record is not an exact CDRM6D1 diagnostic");
+  }
+  const u32 = exactU32;
+  return Object.freeze({
+    attempted_boundary: u64Text(value.attemptedBoundary, "attempted boundary"),
+    canonical_overflowed: value.canonicalOverflowed === true,
+    completion_queued: u32(value.completionQueued, "completion queued"),
+    cpu_guest_fault: value.cpuGuestFault === true,
+    current_bus_irq: u32(value.currentBusIrq, "current bus irq"),
+    current_disk_status: u32(value.currentDiskStatus, "current disk status"),
+    current_transfer_reset_enables: u32(value.currentTransferResetEnables, "transfer state"),
+    disk_evidence: Object.freeze({
+      capacity: u32(value.diskEvidence.capacity, "evidence capacity"),
+      count: u32(value.diskEvidence.count, "evidence count"),
+      overflowed: value.diskEvidence.overflowed === true,
+      have_last: value.evidence.haveLast === true,
+      intra_slot: u32(value.evidence.intraSlot, "intra slot"),
+      last_observed_attempt_slot: u64Text(value.evidence.lastSlot, "last observed attempt slot"),
+      next_sequence: u64Text(value.evidence.nextSequence, "evidence sequence"),
+      observed_after: Object.freeze({
+        bus_irq: u32(observed.busIrq, "observed bus irq"),
+        ccw_address: u32(observed.ccwAddress, "observed ccw address"),
+        ccw_index: u32(observed.ccwIndex, "observed ccw index"),
+        clp: u32(observed.clp, "observed clp"), command: u32(observed.command, "observed command"),
+        completion_queued: u32(observed.completionQueued, "observed completion queued"),
+        da: u32(observed.da, "observed da"),
+        expected_completion: u64Text(observed.expectedCompletion, "observed completion"),
+        generation: u64Text(observed.generation, "observed generation"),
+        lba: u64Text(observed.lba, "observed lba"), lma: u32(observed.lma, "observed lma"),
+        operation: u32(observed.operation, "observed operation"),
+        request_id: u64Text(observed.requestId, "observed request id"),
+        status: u32(observed.status, "observed status"),
+        transfer_reset_enables: u32(observed.transferResetEnables, "observed transfer state"),
+      }),
+    }),
+    lifecycle: u32(value.lifecycle, "lifecycle"),
+    microinstructions: u64Text(value.microinstructions, "microinstructions"),
+    outstanding_operation: u32(value.outstandingOperation, "outstanding operation"),
+    persistent_status: u32(value.persistentStatus, "persistent status"),
+    state_digest: digestBytes(value.stateDigest, "state digest"),
+    trace: Object.freeze({ active: false, failure_ledger_unavailable: true }),
+    unexpected_bus_operation: u32(value.unexpectedBusOperation, "unexpected bus operation"),
+  });
+}
+
+/* This conclusion names capacity exhaustion at terminal state only.  The
+ * last-observed tuple can have advanced after the first rejected record, and
+ * CDRM6D1 intentionally omits the original event kind and arguments. */
+export function overflowDisposition(report, post, diagnostic) {
+  const framing = report?.runFraming;
+  const evidence = diagnostic.disk_evidence;
+  const observed = evidence.observed_after;
+  const boundary = framing?.cachedLastCompleteBoundary;
+  const boundaryText = typeof boundary === "bigint" ? boundary.toString() : null;
+  const confirmed = report?.reason === "terminal-machine-status" &&
+    report?.status === 12 && framing?.operation === "run-digest-batch-m5" &&
+    framing.terminalStatus === 12 && boundary !== null &&
+    boundaryText !== null && post?.lastCompleteBoundary === boundary &&
+    diagnostic.attempted_boundary === boundaryText &&
+    evidence.last_observed_attempt_slot === boundaryText && evidence.have_last === true &&
+    evidence.overflowed === true && evidence.count === evidence.capacity &&
+    evidence.next_sequence === evidence.count.toString() &&
+    evidence.next_sequence === evidence.capacity.toString() &&
+    diagnostic.lifecycle === 3 && diagnostic.persistent_status === 12 &&
+    diagnostic.canonical_overflowed === false && diagnostic.cpu_guest_fault === false &&
+    diagnostic.unexpected_bus_operation === 0 && diagnostic.outstanding_operation === 0 &&
+    observed.operation === diagnostic.outstanding_operation &&
+    diagnostic.completion_queued === 0 && observed.completion_queued === diagnostic.completion_queued &&
+    diagnostic.trace.active === false &&
+    diagnostic.current_disk_status === (observed.status | 64) &&
+    (diagnostic.current_transfer_reset_enables & 1) === 0 &&
+    (diagnostic.current_transfer_reset_enables & 14) ===
+      (observed.transfer_reset_enables & 14) &&
+    diagnostic.current_bus_irq === observed.bus_irq;
+  return confirmed ? "disk-evidence-capacity-exhaustion-guest-fault-observed" :
+    "terminal-cause-not-attributed";
+}
+
+/* Always attempt every close.  The launcher owns stage removal after its own
+ * post-child rehash, but the helper's optional remover makes the invariant
+ * directly testable for standalone/failed setup callers. */
+export async function disposeDiagnosticResources({ client, artifacts, removeStage = null }) {
+  const errors = [];
+  if (client !== null) try { await client.close(); } catch (error) { errors.push(error); }
+  if (artifacts !== null) try { await artifacts.close(); } catch (error) { errors.push(error); }
+  if (removeStage !== null) try { await removeStage(); } catch (error) { errors.push(error); }
+  if (errors.length === 1) throw errors[0];
+  if (errors.length > 1) throw new AggregateError(errors, "diagnostic cleanup failed");
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2));
+  const startHashes = await rehashClosedBuild(options.buildRecord);
+  let client = null;
+  let artifacts = null;
+  try {
+    process.stderr.write("M6 one-run diagnostic: loading staged profile\n");
+    const loaded = await loadProfile();
+    artifacts = await openArtifacts(loaded.expected, options.artifactRoot);
+    const preflight = await preflightM6Artifacts({ artifacts: artifacts.artifacts,
+      profile: loaded.profile, hashArtifact });
+    process.stderr.write("M6 one-run diagnostic: starting one bounded worker run\n");
+    const module = await WebAssembly.compile(await readFile(options.buildRecord.wasm.path));
+    client = new Client(new Worker(pathToFileURL(options.buildRecord.worker.path), { type: "module" }));
+    const instantiate = await client.request("instantiate", { module });
+    if (instantiate.status !== 0) throw new Error(`diagnostic instantiate failed: ${instantiate.status}`);
+    const result = await runM6HeadlessBoot({
+      artifacts: preflight.sources, client, hashArtifact, maxBoundaries: loaded.maxBoundaries,
+      maxHostTransactions: 1024, profile: loaded.profile,
+      onProgress: checkpoint => {
+        process.stderr.write("M6 one-run diagnostic: boundary " +
+          `${checkpoint.boundary} after ${checkpoint.turn} batches and ` +
+          `${checkpoint.hostTransactions} host transactions\n`);
+      },
+      ready: Object.freeze({ contract: CADR_M6_READY_CONTRACT,
+        releaseRecord: loaded.releaseBytes.slice() }),
+    });
+    if (result.outcome !== "failed" || result.report?.phase !== "run" ||
+        result.report?.runFraming === null) {
+      throw new Error("one-run diagnostic did not retain a terminal run failure");
+    }
+    process.stderr.write("M6 one-run diagnostic: reading terminal CDRM6D1 record\n");
+    const post = await client.request("post-terminal-diagnostic");
+    if (post.status !== 0 || post.wireSchema !== "CDRM6D1" ||
+        post.terminalCoreDigestVerified !== true || post.terminalQueueDigestVerified !== true) {
+      throw new Error("post-terminal record was not bound to retained terminal digests");
+    }
+    const diagnostic = normalizeDiagnostic(post.diagnostic);
+    if (diagnostic.state_digest !== digestBytes(result.report.cdrstate5Sha256, "retained CDRSTATE5") ||
+        post.lastCompleteBoundary !== BigInt(result.report.runFraming.cachedLastCompleteBoundary ?? -1n)) {
+      throw new Error("post-terminal record is not bound to the original failure report");
+    }
+    const report = Object.freeze({ ...result.report, runFraming: Object.freeze({
+      ...result.report.runFraming,
+      postCallAttemptedBoundary: post.diagnostic.attemptedBoundary,
+    }) });
+    const failure = canonicalM6FailureDiagnostic({
+      schema: "cadr-m6-wasm-ready-conformance-v1", outcome: "failed",
+      completed_runs: 0, failed_run: 0,
+      failure: { preflight: result.preflight, report, run_evidence: result.runEvidence,
+        transcript_tail: result.transcriptTail },
+    });
+    const endHashes = await rehashClosedBuild(options.buildRecord);
+    const disposition = overflowDisposition(report, post, diagnostic);
+    const receipt = Object.freeze({
+      diagnostic_build: Object.freeze({
+        builder_sha256: options.buildRecord.builder_sha256,
+        delta_sha256: options.buildRecord.diagnostic_delta_sha256,
+        launcher: Object.freeze({
+          script: "scripts/run-cadr-m6-one-run-diagnostic.mjs",
+          sha256: options.buildRecord.launcher.sha256,
+        }),
+        staged_tree_git_object: options.buildRecord.staged_tree_git_object,
+        artifacts_at_start: startHashes,
+        artifacts_before_publication: endHashes,
+      }),
+      disposition,
+      driver: Object.freeze({ repetitions: 1,
+        script: "scripts/run-cadr-m6-one-run-diagnostic-stage.mjs",
+        synthetic_entrypoint_used: false }),
+      failure,
+      post_terminal_diagnostic: diagnostic,
+      release_record: Object.freeze({ sha256: loaded.releaseSha256 }),
+      schema: "cadr-m6-one-run-cause-witness-v1",
+    });
+    const written = await writePrivateNoReplace(options.output, receipt);
+    process.stdout.write(`wrote private one-run cause witness ${relative(ROOT, options.output)} (${written.byte_count} bytes, ${written.sha256})\n`);
+    if (disposition !== "disk-evidence-capacity-exhaustion-guest-fault-observed") {
+      throw new Error("terminal cause remained un-attributed; private receipt was retained");
+    }
+  } finally {
+    await disposeDiagnosticResources({ client, artifacts });
+  }
+}
+
+if (typeof process.argv[1] === "string" &&
+    import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  main().catch(error => {
+    process.stderr.write(`${error?.stack ?? String(error)}\n`);
+    process.exitCode = 1;
+  });
+}
