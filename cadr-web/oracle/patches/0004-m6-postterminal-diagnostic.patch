new file mode 100644
index 0000000..bb04853
--- /dev/null
+++ b/cadr-web/tests/test_cadr_m6_postterminal_adapter.c
@@ -0,0 +1,57 @@
+/* The diagnostic export is compiled into this native test translation unit so
+ * its otherwise-private machine pointer can be snapshotted byte-for-byte.
+ * Prime the lazy failure digest cache before the snapshot: the tested export
+ * must be observational after that normal cache initialization. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CADR_M6_DIAGNOSTIC_WASM 1
+#define CADR_WASM_NATIVE_TEST 1
+#include "../wasm/cadr_wasm_adapter.c"
+
+/* The adapter's snapshot paths name these freestanding-Wasm allocator hooks,
+ * but this observation fixture neither saves nor restores a snapshot.  Keep
+ * native allocation in libc so address-space layout cannot masquerade as a
+ * diagnostic mutation. */
+uintptr_t cadr_wasm_allocator_mark(void)
+{
+    return 0U;
+}
+
+void cadr_wasm_allocator_rollback(uintptr_t mark)
+{
+    (void)mark;
+}
+
+static int fail(const char *message)
+{
+    (void)fprintf(stderr, "test_cadr_m6_postterminal_adapter: %s\n", message);
+    return 1;
+}
+
+int main(void)
+{
+    uint8_t digest[CADR_SHA256_BYTES];
+    uint8_t *before;
+    uint32_t status;
+    if (cadr_wasm_create() != CADR_STATUS_OK) return fail("create");
+    if (cadr_wasm_output_pointer() == 0U) return fail("output allocation");
+    if (cadr_machine_state_v5_failure_digest(cadr_wasm_machine, digest) !=
+        CADR_STATUS_OK) return fail("prime failure digest");
+    before = malloc(sizeof(cadr_machine_state));
+    if (before == NULL) return fail("snapshot allocation");
+    (void)memcpy(before, &cadr_wasm_machine->state, sizeof(cadr_machine_state));
+    status = cadr_wasm_post_terminal_diagnostic();
+    if (status != CADR_STATUS_OK) {
+        free(before);
+        return fail("post-terminal diagnostic");
+    }
+    if (memcmp(before, &cadr_wasm_machine->state, sizeof(cadr_machine_state)) != 0) {
+        free(before);
+        return fail("diagnostic mutated cadr_machine_state");
+    }
+    free(before);
+    return 0;
+}
