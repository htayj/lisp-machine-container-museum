+uint32_t cadr_m6_witness_take_m7_c_boundary(void)
+{
+#ifdef WITH_CADR_M7_FRAME_ORACLE
+    if (!initialized || failed || !capture_c || m7_c_boundary_taken) return 0U;
+    m7_c_boundary_taken = 1;
+    return 1U;
+#else
+    return 0U;
+#endif
+}
+
+uint32_t cadr_m6_witness_failed(void)
+{
+    return failed != 0 ? 1U : 0U;
+}
+
 int cadr_m6_witness_boundary(uint64_t boundary, uint64_t debug_ir, uint32_t observed_iob_csr,
                               uint32_t observed_kbd_scancode, uint16_t sixty_cycle_clock,
                               uint32_t disk_busy, uint32_t host_request_pending)
 {
     int selected = capture_a || capture_b || capture_c;
     if (!initialized || failed) return 0;
+#ifdef WITH_CADR_M7_FRAME_ORACLE
+    /* This is reached after ucode_run has advanced machine_cycles for the
+     * slot that wrote C, and before the M6 clock/cleanup policy mutates a
+     * later boundary.  It is the cross-target M7 checkpoint boundary. */
+    if (cadr_m6_witness_take_m7_c_boundary() != 0U &&
+        cadr_m7_frame_witness_capture(boundary) != 0) {
+        fail("m7-frame-capture-failed");
+        return 0;
+    }
+#endif
     /* M5 policy: dispatch the guest 60 Hz edge before a coincident key. */
     while (((clock_events + 1U) * UINT64_C(1000000) + 59U) / 60U == boundary) {
         if (tv_assert_interrupt == NULL || colortv_assert_interrupt == NULL || &colortv_enabled == NULL || &the_60_cycle_clock == NULL) { fail("missing-60hz-device"); return 0; }
